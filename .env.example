# Copia este archivo como .env.local para trabajar contra otra API sin tocar el repositorio.

# A dónde apunta el proxy de desarrollo. Vacío = la API publicada en Azure.
# Para la API local:
# VITE_PROXY_TARGET=http://localhost:5080

# Solo se usa en el sitio construido (npm run build). En desarrollo se deja vacío
# para que las peticiones salgan como /api y las tome el proxy.
# VITE_API_URL=
